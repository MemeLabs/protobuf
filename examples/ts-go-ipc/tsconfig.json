{
  "compilerOptions": {
    "outDir": "dist",
    "module": "commonjs",
    "target": "es6",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["es6", "es2020", "esnext.asynciterable"],
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "client.ts"],
  "exclude": ["dist", "node_modules"]
}
