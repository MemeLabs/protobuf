{
  "compilerOptions": {
    "declaration": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "lib": ["dom", "es2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "lib",
    "removeComments": true,
    "rootDir": "src",
    "strict": false,
    "target": "es5",
    "types": ["node", "mocha"]
  },
  "include": ["src"],
  "exclude": ["lib", "node_modules"]
}
